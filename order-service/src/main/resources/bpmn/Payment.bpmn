<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_payment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="PaymentProcess" name="Payment" isExecutable="true">
    <bpmn:startEvent id="StartPayment" name="Payment started">
      <bpmn:outgoing>Flow_p1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="AssessRisk" name="Assess the payment risk" camunda:resultVariable="riskLevel" camunda:decisionRef="PaymentRisk" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_p1</bpmn:incoming>
      <bpmn:outgoing>Flow_p2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="RiskGateway" name="Risk level?" default="Flow_p_ok">
      <bpmn:incoming>Flow_p2</bpmn:incoming>
      <bpmn:outgoing>Flow_p_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_p_high</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ChargeCustomer" name="Charge the customer" camunda:asyncBefore="true" camunda:type="external" camunda:topic="chargeCustomer">
      <bpmn:incoming>Flow_p_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_p3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ReviewPayment" name="Review the payment" camunda:candidateGroups="risk-officers">
      <bpmn:incoming>Flow_p_high</bpmn:incoming>
      <bpmn:outgoing>Flow_p4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PaymentDone" name="Payment charged">
      <bpmn:incoming>Flow_p3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="PaymentRejected" name="Payment rejected">
      <bpmn:incoming>Flow_p4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p1" sourceRef="StartPayment" targetRef="AssessRisk" />
    <bpmn:sequenceFlow id="Flow_p2" sourceRef="AssessRisk" targetRef="RiskGateway" />
    <bpmn:sequenceFlow id="Flow_p_ok" name="low / medium" sourceRef="RiskGateway" targetRef="ChargeCustomer" />
    <bpmn:sequenceFlow id="Flow_p_high" name="high" sourceRef="RiskGateway" targetRef="ReviewPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskLevel == "HIGH"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_p3" sourceRef="ChargeCustomer" targetRef="PaymentDone" />
    <bpmn:sequenceFlow id="Flow_p4" sourceRef="ReviewPayment" targetRef="PaymentRejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="PaymentProcess">
      <bpmndi:BPMNShape id="StartPayment_di" bpmnElement="StartPayment">
        <dc:Bounds x="182" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AssessRisk_di" bpmnElement="AssessRisk">
        <dc:Bounds x="260" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RiskGateway_di" bpmnElement="RiskGateway" isMarkerVisible="true">
        <dc:Bounds x="420" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="418" y="112" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ChargeCustomer_di" bpmnElement="ChargeCustomer">
        <dc:Bounds x="560" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewPayment_di" bpmnElement="ReviewPayment">
        <dc:Bounds x="560" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentDone_di" bpmnElement="PaymentDone">
        <dc:Bounds x="722" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentRejected_di" bpmnElement="PaymentRejected">
        <dc:Bounds x="722" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_p1_di" bpmnElement="Flow_p1">
        <di:waypoint x="218" y="160" />
        <di:waypoint x="260" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2_di" bpmnElement="Flow_p2">
        <di:waypoint x="360" y="160" />
        <di:waypoint x="420" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p_ok_di" bpmnElement="Flow_p_ok">
        <di:waypoint x="470" y="160" />
        <di:waypoint x="560" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p_high_di" bpmnElement="Flow_p_high">
        <di:waypoint x="445" y="185" />
        <di:waypoint x="445" y="300" />
        <di:waypoint x="560" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p3_di" bpmnElement="Flow_p3">
        <di:waypoint x="660" y="160" />
        <di:waypoint x="722" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p4_di" bpmnElement="Flow_p4">
        <di:waypoint x="660" y="300" />
        <di:waypoint x="722" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
